            },
            "weekdays": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              },
              "description": "0=Sun..6=Sat, for weekdays"
            },
            "visible_to_creator": {
              "type": "boolean"
            }
          },
          "required": [
