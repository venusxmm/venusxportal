                },
                {
                  "type": "null"
                }
              ],
              "description": "Date YYYY-MM-DD (America/Bogota)"
            },
            "due_time": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\d{2}:\\d{2}$"
                },
