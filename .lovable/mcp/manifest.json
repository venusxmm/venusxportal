            "before_task_id": {
              "type": "string",
              "format": "uuid",
              "description": "Place above this task; omit to place last."
            }
          },
          "required": [
            "task_id",
            "date",
            "block"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
